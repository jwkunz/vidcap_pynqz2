part=xc7z020clg400-1

[hls]
flow_target=vivado
clock=10ns
clock_uncertainty=15%
syn.top=vc_tavg
syn.file=@SRC@/vc_tavg.cpp
syn.cflags=@CTRL@ -DVC_WIDTH=@W@ -DVC_HEIGHT=@H@ -DVC_TAVG_DEPTH=@TAVG_DEPTH@ -I@COMMON@ -I@SRC@
tb.file=@SRC@/tb/tb_vc_tavg.cpp
tb.cflags=-DVC_WIDTH=@W@ -DVC_HEIGHT=@H@ -DVC_TAVG_DEPTH=@TAVG_DEPTH@ -I@COMMON@ -I@SRC@
package.output.format=ip_catalog
package.output.syn=false
package.ip.display_name=vidcap temporal average
package.ip.name=vc_tavg
package.ip.vendor=vidcap
package.ip.library=vidcap
package.ip.version=1.0
