# 240p: 720(1440)x240 @ 60.05 Hz, 27 MHz (CEA-861 VIC 8/9). Each of the 720 real pixels is sent twice, so the link
# carries 1440 samples per line; the receiver is a DVI decoder and simply hands them on. This is the Wii's mode.
MODE=240p
WIDTH=1440
HEIGHT=240
PIXEL_MHZ=27.000
RX_CLK_RANGE=5
TX_CLK_RANGE=5
EDID=240p_edid.data
VTC_MODE=Custom
# CEA timing, horizontal values doubled: 1440 + front 38 + sync 124 + back 114 = 1716; V 240 + front 4 + sync 3 + back 15 = 262
H_FRAME=1716
H_SYNC_START=1478
H_SYNC_END=1602
V_FRAME=262
V_SYNC_START=244
V_SYNC_END=247
SYNC_POLARITY=Low
