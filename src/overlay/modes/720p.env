# 720p: 1280x720 @ 60 Hz, 74.25 MHz (CEA-861 VIC 4). Uses the stock 720p EDID and Vivado's own 720p timing preset.
MODE=720p
WIDTH=1280
HEIGHT=720
PIXEL_MHZ=74.250
# Digilent receiver / transmitter clock band: VCO = 5 x k x pixel clock must stay in 600..1200 MHz
RX_CLK_RANGE=2
TX_CLK_RANGE=2
EDID=720p_edid.data
VTC_MODE=720p
# the input clock is constrained at 120 MHz (conservative; what the verified build used), not 74.25
RX_CONSTRAIN_MHZ=120
