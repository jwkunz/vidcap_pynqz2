# 1080p30: 1920x1080 @ 30 Hz, 74.25 MHz (CEA-861 VIC 34). Same pixel clock as 720p60, so it fits the 100 MHz pipeline.
# The source must be willing to send 30 Hz; the EDID offers nothing else.
MODE=1080p30
WIDTH=1920
HEIGHT=1080
PIXEL_MHZ=74.250
RX_CLK_RANGE=2
TX_CLK_RANGE=2
EDID=1080p30_edid.data
VTC_MODE=Custom
# H 1920 + front 88 + sync 44 + back 148 = 2200; V 1080 + front 4 + sync 5 + back 36 = 1125; both syncs positive
H_FRAME=2200
H_SYNC_START=2008
H_SYNC_END=2052
V_FRAME=1125
V_SYNC_START=1084
V_SYNC_END=1089
SYNC_POLARITY=High
