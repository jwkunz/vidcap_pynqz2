# 480p: 720x480 @ 59.94 Hz, 27 MHz (CEA-861 VIC 2/3). Note Vivado's own "480p" preset is VGA 640x480, not this.
MODE=480p
WIDTH=720
HEIGHT=480
PIXEL_MHZ=27.000
RX_CLK_RANGE=5
TX_CLK_RANGE=5
EDID=480p_edid.data
VTC_MODE=Custom
# CEA timing: H 720 + front 16 + sync 62 + back 60 = 858; V 480 + front 9 + sync 6 + back 30 = 525; both syncs negative
H_FRAME=858
H_SYNC_START=736
H_SYNC_END=798
V_FRAME=525
V_SYNC_START=489
V_SYNC_END=495
SYNC_POLARITY=Low
